# =============================================================================
# SenioCare - Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# =============================================================================

# --- PostgreSQL (Neon) -------------------------------------------------------
# Tools database (meals, exercises, drug interactions, medical reports, ...)
APP_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ADK session database (conversation sessions & user profile state)
SESSION_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# Connection handling for APP_DATABASE_URL (defaults shown). Connections are
# pooled; a connect or query that exceeds its deadline raises instead of hanging.
#APP_DATABASE_CONNECT_TIMEOUT_S=10
#APP_DATABASE_QUERY_TIMEOUT_S=20
#APP_DATABASE_POOL_SIZE=4

# --- Model ---------------------------------------------------------------------
# Any LiteLLM model string. The backend talks to it exactly like an external
# API: tools, prompts and data stay here, only inference moves.
#   ollama_chat/gemma4:e4b             local Ollama (default, MODEL_API_BASE blank)
#   openai/gemma4:e4b                  Ollama on Colab, MODEL_API_BASE=https://<tunnel>/v1
#   hosted_vllm/google/gemma-3-4b-it   vLLM on Colab,   MODEL_API_BASE=https://<tunnel>/v1
#   gemini/gemini-2.5-flash            Google AI Studio, MODEL_API_KEY=<key>
MODEL_NAME=ollama_chat/gemma4:e4b
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_TIMEOUT_S=120
# Sampling (blank = provider default). Extra litellm kwargs as JSON if needed.
MODEL_TEMPERATURE=
MODEL_MAX_TOKENS=
#MODEL_EXTRA_JSON={"top_p": 0.9}

# --- Observability -------------------------------------------------------------
# Every LLM call, tool call, stage and turn is emitted as a JSON log line and,
# when APP_DATABASE_URL is set, stored in the llm_traces table (OBS_DB_ENABLED=0
# to disable). GET /metrics/summary and scripts/metrics_report.py aggregate it.
LOG_LEVEL=INFO
OBS_DB_ENABLED=1
# Cost views. Token-priced cost uses litellm's public price for this reference
# model regardless of where inference actually ran (comparable across runs).
COST_REFERENCE_MODEL=gemini/gemini-2.5-flash
# Self-hosted compute view: USD per GPU-hour x wall time. Colab T4 ~0.35, A100 ~1.2, local 0.
MODEL_GPU_USD_PER_HOUR=0
SERPAPI_USD_PER_SEARCH=0.015
# Optional OpenTelemetry export. ADK already creates spans for every LLM and
# tool call; setting this ships them to any OTLP/HTTP collector (Jaeger, Langfuse, ...).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_SERVICE_NAME=seniocare

# --- Eval judge (evals/runner.py) ----------------------------------------------
# A different, stronger model than the pipeline's. Blank = judge tier stays pending.
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_API_BASE=

# --- Web / YouTube / medical search tools (SerpAPI) --------------------------
# Get a key at https://serpapi.com/
SERPAPI_KEY=

# --- Firebase Cloud Messaging (caregiver push notifications) -----------------
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=seniocare-firebase-adminsdk.json

# --- Server ------------------------------------------------------------------
# Port the API server listens on (default: 8080)
PORT=8080

# --- Tests -------------------------------------------------------------------
# Disposable PostgreSQL database used by the test suite.
# NEVER point this at a production database - test fixtures DROP all tables.
TEST_DATABASE_URL=
